# Copy to .env and fill in. .env is gitignored and must never be committed.
# Never paste these values into a chat.

# Telegram bot token from @BotFather. Needed from M3 onwards, not before.
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_IDS=

# Where large downloads live. Defaults to ./data next to the repo root.
FLYMOG_DATA_DIR=
